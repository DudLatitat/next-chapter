<?xml version="1.0" encoding="utf-8"?>
<!-- The weekly routine on the home screen: this week's evenings as dots, and tonight's job. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_week_title"
            android:textColor="#FFFFCF7A"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFCF7A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dot0"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_dot_empty"
                android:gravity="center"
                android:textColor="#FF0E1532"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/day0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="M"
                android:textColor="#FFA9B1D6"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dot1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_dot_empty"
                android:gravity="center"
                android:textColor="#FF0E1532"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/day1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="T"
                android:textColor="#FFA9B1D6"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dot2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_dot_empty"
                android:gravity="center"
                android:textColor="#FF0E1532"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/day2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="W"
                android:textColor="#FFA9B1D6"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dot3"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_dot_empty"
                android:gravity="center"
                android:textColor="#FF0E1532"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/day3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="T"
                android:textColor="#FFA9B1D6"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dot4"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_dot_empty"
                android:gravity="center"
                android:textColor="#FF0E1532"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/day4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="F"
                android:textColor="#FFA9B1D6"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dot5"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_dot_empty"
                android:gravity="center"
                android:textColor="#FF0E1532"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/day5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="S"
                android:textColor="#FFA9B1D6"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dot6"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_dot_empty"
                android:gravity="center"
                android:textColor="#FF0E1532"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/day6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="S"
                android:textColor="#FFA9B1D6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tonight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFEEF1FF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFA9B1D6"
        android:textSize="12sp" />
</LinearLayout>
